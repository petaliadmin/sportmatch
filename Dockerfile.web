# syntax=docker/dockerfile:1.7
# Front Next.js (export statique) servi par nginx, branché sur la gateway locale.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund
COPY next.config.mjs tsconfig.json tailwind.config.ts postcss.config.mjs next-env.d.ts ./
COPY src ./src
ARG NEXT_PUBLIC_API_URL=http://localhost:8080
ARG NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8180
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_KEYCLOAK_URL=$NEXT_PUBLIC_KEYCLOAK_URL \
    NEXT_TELEMETRY_DISABLED=1
RUN npx next build

FROM nginx:1.27-alpine
COPY --from=build /app/out /usr/share/nginx/html
HEALTHCHECK --interval=10s --timeout=3s --retries=10 CMD wget -qO- http://127.0.0.1/ > /dev/null || exit 1
